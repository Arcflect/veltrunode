{
  "application": {
    "account_constraint": "123456789012",
    "name": "minimal-app",
    "region": "ap-northeast-1",
    "stage": "dev"
  },
  "built_at": "2026-01-01T00:00:00Z",
  "compiler_version": "0.1.39",
  "functions": {
    "worker": {
      "architecture": "x86_64",
      "ephemeral_storage": 512,
      "handler": "app.handler",
      "logical_name": "worker",
      "memory": 128,
      "runtime": "ruby3.3",
      "timeout": 30
    }
  },
  "iam_capabilities": {
    "worker": []
  },
  "layers": {},
  "manifest_schema_version": "1.0",
  "schedules": {
    "heartbeat": {
      "expression": "0 12 * * ? *",
      "expression_type": "cron",
      "flexible_window": {
        "mode": "off"
      },
      "name": "heartbeat",
      "state": "enabled",
      "target_function": "worker",
      "timezone": "UTC"
    }
  },
  "schema_version": "1.0"
}
