# frozen_string_literal: true

Veltrunode.application "with-cloudwatch-dashboard" do
  aws region: "ap-northeast-1", account: "123456789012"
  runtime "ruby3.3"

  dashboard true

  function :api do
    handler "handlers/api.handler"
    memory 512
    timeout 30
  end

  function :worker do
    handler "handlers/worker.handler"
    memory 256
    timeout 60
  end
end
