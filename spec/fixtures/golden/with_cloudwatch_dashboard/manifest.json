{
  "application": {
    "account_constraint": "123456789012",
    "name": "with-cloudwatch-dashboard",
    "region": "ap-northeast-1",
    "stage": "dev"
  },
  "built_at": "2026-01-01T00:00:00Z",
  "compiler_version": "0.1.70",
  "dashboard": {
    "enabled": true,
    "name": "default",
    "period": 300,
    "widgets": [
      {
        "height": 6,
        "metric": "invocations",
        "period": 300,
        "stat": "Sum",
        "title": "Invocations",
        "width": 12,
        "x": 0,
        "y": 0
      },
      {
        "height": 6,
        "metric": "errors",
        "period": 300,
        "stat": "Sum",
        "title": "Errors",
        "width": 12,
        "x": 12,
        "y": 0
      },
      {
        "height": 6,
        "metric": "duration",
        "period": 300,
        "stat": "Average",
        "title": "Duration",
        "width": 12,
        "x": 0,
        "y": 6
      },
      {
        "height": 6,
        "metric": "concurrent_executions",
        "period": 300,
        "stat": "Maximum",
        "title": "Concurrent Executions",
        "width": 12,
        "x": 12,
        "y": 6
      }
    ]
  },
  "functions": {
    "api": {
      "architecture": "x86_64",
      "ephemeral_storage": 512,
      "handler": "handlers/api.handler",
      "logical_name": "api",
      "memory": 512,
      "runtime": "ruby3.3",
      "timeout": 30
    },
    "worker": {
      "architecture": "x86_64",
      "ephemeral_storage": 512,
      "handler": "handlers/worker.handler",
      "logical_name": "worker",
      "memory": 256,
      "runtime": "ruby3.3",
      "timeout": 60
    }
  },
  "iam_capabilities": {
    "api": [],
    "worker": []
  },
  "layers": {},
  "manifest_schema_version": "1.0",
  "schedules": {},
  "schema_version": "1.0"
}
