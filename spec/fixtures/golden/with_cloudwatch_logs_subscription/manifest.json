{
  "application": {
    "account_constraint": "123456789012",
    "name": "with-cloudwatch-logs-subscription",
    "region": "ap-northeast-1",
    "stage": "dev"
  },
  "built_at": "2026-01-01T00:00:00Z",
  "compiler_version": "0.1.75",
  "functions": {
    "api": {
      "architecture": "x86_64",
      "ephemeral_storage": 512,
      "handler": "handlers/api.handler",
      "logging": {
        "retention_days": 14
      },
      "logical_name": "api",
      "memory": 512,
      "runtime": "ruby3.3",
      "subscription_filters": [
        {
          "destination": "arn:aws:lambda:ap-northeast-1:123456789012:function:central-logger",
          "destination_type": "auto",
          "filter_pattern": "[timestamp, request_id, level = ERROR*, ...]"
        },
        {
          "destination": "arn:aws:kinesis:ap-northeast-1:123456789012:stream/app-logs-stream",
          "destination_type": "auto",
          "distribution": "ByLogStream",
          "filter_pattern": "",
          "name": "kinesis_stream"
        }
      ],
      "timeout": 30
    }
  },
  "iam_capabilities": {
    "api": []
  },
  "layers": {},
  "manifest_schema_version": "1.0",
  "schedules": {},
  "schema_version": "1.0"
}
