# frozen_string_literal: true

app_name = ENV.fetch('VELTRUNODE_TEST_APP_NAME', 'integ-at-sched')
region = ENV.fetch('AWS_REGION', 'ap-northeast-1')
account = ENV.fetch('AWS_ACCOUNT_ID', '123456789012')
target_at = ENV.fetch('VELTRUNODE_TEST_SCHEDULE_AT', '2030-01-01T00:00:00')

Veltrunode.application app_name do
  aws region: region, account: account
  runtime ruby: '3.3', architecture: :x86_64

  function :scheduled_worker do
    handler 'app.handler'
    memory 128
    timeout 30
  end

  schedule :one_time_trigger do
    target :scheduled_worker
    at target_at
  end
end
