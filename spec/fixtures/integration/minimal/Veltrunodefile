# frozen_string_literal: true

app_name = ENV.fetch('VELTRUNODE_TEST_APP_NAME', 'integ-minimal')
region = ENV.fetch('AWS_REGION', 'ap-northeast-1')
account = ENV.fetch('AWS_ACCOUNT_ID', '123456789012')

Veltrunode.application app_name do
  aws region: region, account: account
  runtime ruby: '3.3', architecture: :x86_64

  function :worker do
    handler 'app.handler'
    memory 128
    timeout 30
  end

  schedule :heartbeat do
    target :worker
    cron '0 12 * * ? *'
  end
end
